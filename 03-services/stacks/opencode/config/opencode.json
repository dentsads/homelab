{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "openrouter": {
      "options": {
        "apiKey": "{env:OPENROUTER_API_KEY}"
      }
    },
    "opencode": {
      "options": {
        "apiKey": "{env:OPENCODE_ZEN_API_KEY}"
      }
    }
  },
  "enabled_providers": ["openrouter", "opencode"],
  "server": {
    "port": 8085,
    "hostname": "0.0.0.0"
  },
  "share": "disabled"
}
